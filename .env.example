# Copier en .env pour le développement local (make install le fait).
SECRET_KEY=dev-uniquement-a-remplacer
# Port 5433 : évite le conflit avec un PostgreSQL local (réglable par DB_PORT dans docker-compose).
DATABASE_URL=postgres://dianna:dianna@localhost:5433/dianna
# ALLOWED_HOSTS=.localhost,127.0.0.1
# LOG_LEVEL=INFO

# Production uniquement :
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=.dianna.fr
# CSRF_TRUSTED_ORIGINS=https://*.dianna.fr
