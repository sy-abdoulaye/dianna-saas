# Copier en .env pour le développement local (make install le fait).
SECRET_KEY=dev-uniquement-a-remplacer
# Port 5434 : évite le conflit avec un PostgreSQL local (réglable par DB_PORT dans docker-compose).
DATABASE_URL=postgres://dianna:dianna@localhost:5434/dianna
# ALLOWED_HOSTS=.localhost,localhost
# Domaine de base : vitrine sur BASE_DOMAIN, éditeur sur admin.BASE_DOMAIN, entreprises sur <slug>.BASE_DOMAIN
# BASE_DOMAIN=localhost
# Faire tourner deux copies du projet sur la même machine : port du serveur (make up),
# port de PostgreSQL et nom du projet Compose (base et volume séparés). Si DB_PORT change,
# DATABASE_URL doit utiliser le même port.
# APP_PORT=8000
# DB_PORT=5434
# COMPOSE_PROJECT_NAME=dianna
# Port des liens des e-mails en développement (APP_PORT par défaut) :
# SITE_PORT=8000
# Double authentification des comptes de démonstration (développement seulement) :
# DEMO_DISABLE_2FA=true
# LOG_LEVEL=INFO

# Clé de chiffrement des secrets de double authentification (Fernet), distincte de SECRET_KEY.
# Facultative en développement (clé publique de dev.py), obligatoire en production.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changer de clé : nouvelle clé en premier, ancienne ensuite, séparées par une virgule.
# MFA_ENCRYPTION_KEY=
# Clé de chiffrement des arguments des tâches qui portent un e-mail d'allauth (réinitialisation
# du mot de passe…), distincte de SECRET_KEY et de MFA_ENCRYPTION_KEY. Même format, même
# rotation. Facultative en développement, obligatoire en production.
# TASKS_ENCRYPTION_KEY=
# Fichiers privés (photos, logos, justificatifs), L5-02 : « filesystem » en développement
# (dossier PRIVATE_MEDIA_ROOT), « s3 » en production (Scaleway Object Storage, région fr-par),
# un bucket privé par environnement. Valeur par défaut en production : s3.
# PRIVATE_STORAGE_BACKEND=filesystem
# PRIVATE_MEDIA_ROOT=./private_media
# S3_BUCKET=dianna-production
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Chiffrement côté serveur des objets (AES256 par défaut en production ; vide = désactivé).
# S3_SERVER_SIDE_ENCRYPTION=AES256
# Nombre de proxys de confiance devant l'application (X-Forwarded-For), 0 sans proxy.
# TRUSTED_PROXY_COUNT=0

# Production uniquement :
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=.dianna.fr,dianna.fr
# BASE_DOMAIN=dianna.fr
# CSRF_TRUSTED_ORIGINS=https://*.dianna.fr
